right\"},{\"id\":\"MA\",\"name\":\"MA\",\"type\":\"character\",\"header\":\"Area<div class=\\\"sub\\\">median change<\\/div>\",\"html\":true,\"align\":\"right\"},{\"id\":\"MM\",\"name\":\"MM\",\"type\":\"character\",\"header\":\"Mean area<div class=\\\"sub\\\">median change<\\/div>\",\"html\":true,\"align\":\"right\"},{\"id\":\"CE\",\"name\":\"CE\",\"type\":\"character\",\"header\":\"Lost establishments<div class=\\\"sub\\\">municipalities<\\/div>\",\"html\":true,\"align\":\"right\"},{\"id\":\"CA\",\"name\":\"CA\",\"type\":\"character\",\"header\":\"Lost area<div class=\\\"sub\\\">municipalities<\\/div>\",\"html\":true,\"align\":\"right\"}],\"sortable\":false,\"pagination\":false,\"compact\":true,\"className\":\"tabela-res\",\"dataKey\":\"9c296f7ecf0d63b598bf2d679e7c65aa\"},\"children\":[]},\"class\":\"reactR_markup\"},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\nMedian municipal change and municipalities with losses, by municipal type\n\n:::\n\n::: {#tbl-testes-tipo}\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"reactable html-widget html-fill-item\" id=\"htmlwidget-2f0f58fdcba150ecff2b\" style=\"width:auto;height:auto;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-2f0f58fdcba150ecff2b\">{\"x\":{\"tag\":{\"name\":\"Reactable\",\"attribs\":{\"data\":{\"Medida\":[\"Change in the number of establishments (%)\",\"Change in area (%)\",\"Change in mean area per establishment (%)\"],\"H\":[\"6.11\",\"0.26\",\"6.00\"],\"gl\":[\"4\",\"4\",\"4\"],\"p\":[\"p = 0.191\",\"p = 0.992\",\"p = 0.199\"],\"Efeito\":[\"0.044\",\"0.002\",\"0.043\"]},\"columns\":[{\"id\":\"Medida\",\"name\":\"Measure\",\"type\":\"character\",\"minWidth\":260},{\"id\":\"H\",\"name\":\"Kruskal-Wallis H\",\"type\":\"character\",\"align\":\"right\"},{\"id\":\"gl\",\"name\":\"Degrees of freedom\",\"type\":\"character\",\"align\":\"right\"},{\"id\":\"p\",\"name\":\"p\",\"type\":\"character\",\"align\":\"right\"},{\"id\":\"Efeito\",\"name\":\"Efeito\",\"type\":\"character\",\"header\":\"Effect size<div class=\\\"sub\\\">ε² = H ÷ (n − 1)<\\/div>\",\"html\":true,\"align\":\"right\"}],\"sortable\":false,\"pagination\":false,\"compact\":true,\"dataKey\":\"c1c46f457cd4c99b33ff07cd6d1cee56\"},\"children\":[]},\"class\":\"reactR_markup\"},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n\n::: {.cell-output-display}\n\n```{=html}\n<p class=\"nota-fonte\">Note: Kruskal-Wallis test on percentage changes in the 141 municipalities (5 types), not corrected for spatial autocorrelation. Source: authors’ calculations based on IBGE, 2006 and 2017 Agricultural Censuses (SIDRA), all agricultural establishments; municipal database from Article C (corrected version); municipal types from RESA Project Manuscript 1 (provisional labels); dominant biome from the IBGE 1:250,000 map (2019).</p>\n```\n\n:::\n:::\n\n\nTests for differences in change between types\n\n:::\n\n## Change by biome\n\n::: {#tbl-dinamica-bioma}\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"reactable html-widget html-fill-item\" id=\"htmlwidget-6aef29c39c2a63b9d38c\" style=\"width:auto;height:auto;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-6aef29c39c2a63b9d38c\">{\"x\":{\"tag\":{\"name\":\"Reactable\",\"attribs\":{\"data\":{\"Grupo\":[\"<span class=\\\"chip chip-amazonia\\\">Amazon<\\/span>\",\"<span class=\\\"chip chip-cerrado\\\">Cerrado<\\/span>\",\"<span class=\\\"chip chip-pantanal\\\">Pantanal<\\/span>\",\"<b>Mato Grosso<\\/b>\"],\"Municípios\":[\"76\",\"61\",\"4\",\"141\"],\"E6\":[\"69,221\",\"37,022\",\"6,744\",\"112,987\"],\"E7\":[\"69,602\",\"39,786\",\"9,291\",\"118,679\"],\"VE\":[\"0.6%\",\"7.5%\",\"37.8%\",\"5.0%\"],\"A6\":[\"25.86\",\"19.84\",\"2.99\",\"48.69\"],\"A7\":[\"29.59\",\"21.20\",\"4.13\",\"54.92\"],\"VA\":[\"14.4%\",\"6.8%\",\"38.2%\",\"12.8%\"],\"M6\":[\"374\",\"536\",\"443\",\"431\"],\"M7\":[\"425\",\"533\",\"445\",\"463\"],\"VM\":[\"13.8%\",\"−0.6%\",\"0.3%\",\"7.4%\"]},\"columns\":[{\"id\":\"Grupo\",\"name\":\"Biome (IBGE 1:250,000)\",\"type\":\"character\",\"html\":true,\"minWidth\":200,\"sticky\":\"left\"},{\"id\":\"Municípios\",\"name\":\"Municipalities\",\"type\":\"character\",\"minWidth\":105,\"align\":\"right\"},{\"id\":\"E6\",\"name\":\"2006\",\"type\":\"character\",\"align\":\"right\"},{\"id\":\"E7\",\"name\":\"2017\",\"type\":\"character\",\"align\":\"right\"},{\"id\":\"VE\",\"name\":\"Change\",\"type\":\"character\",\"align\":\"right\",\"style\":{\"fontWeight\":600}},{\"id\":\"A6\",\"name\":\"2006\",\"type\":\"character\",\"align\":\"right\"},{\"id\":\"A7\",\"name\":\"2017\",\"type\":\"character\",\"align\":\"right\"},{\"id\":\"VA\",\"name\":\"Change\",\"type\":\"character\",\"align\":\"right\",\"style\":{\"fontWeight\":600}},{\"id\":\"M6\",\"name\":\"2006\",\"type\":\"character\",\"align\":\"right\"},{\"id\":\"M7\",\"name\":\"2017\",\"type\":\"character\",\"align\":\"right\"},{\"id\":\"VM\",\"name\":\"Change\",\"type\":\"character\",\"align\":\"right\",\"style\":{\"fontWeight\":600}}],\"columnGroups\":[{\"name\":\"Establishments\",\"columns\":[\"E6\",\"E7\",\"VE\"]},{\"name\":\"Area, million ha\",\"columns\":[\"A6\",\"A7\",\"VA\"]},{\"name\":\"Mean area (ha per establishment)\",\"columns\":[\"M6\",\"M7\",\"VM\"]}],\"sortable\":false,\"pagination\":false,\"compact\":true,\"className\":\"tabela-res\",\"dataKey\":\"30914637fcf3bfb26e8a511ed5779085\"},\"children\":[]},\"class\":\"reactR_markup\"},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n:::\n\n\nEstablishments, area and mean area, by dominant biome\n\n:::\n\n@tbl-medianas-bioma gives the median municipal change and the tests for differences between biomes.\n\n::: {#tbl-medianas-bioma}\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"reactable html-widget html-fill-item\" id=\"htmlwidget-27003eb09eb1ad6b8090\" style=\"width:auto;height:auto;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-27003eb09eb1ad6b8090\">{\"x\":{\"tag\":{\"name\":\"Reactable\",\"attribs\":{\"data\":{\"Grupo\":[\"<span class=\\\"chip chip-amazonia\\\">Amazon<\\/span>\",\"<span class=\\\"chip chip-cerrado\\\">Cerrado<\\/span>\",\"<span class=\\\"chip chip-pantanal\\\">Pantanal<\\/span>\",\"<b>Mato Grosso<\\/b>\"],\"ME\":[\"0.2%\",\"9.8%\",\"33.5%\",\"7.6%\"],\"MA\":[\"9.1%\",\"9.7%\",\"41.4%\",\"9.6%\"],\"MM\":[\"12.4%\",\"−0.7%\",\"0.5%\",\"7.0%\"],\"CE\":[\"38 of 76\",\"19 of 61\",\"1 of 4\",\"58 of 141\"],\"CA\":[\"28 of 76\",\"21 of 61\",\"0 of 4\",\"49 of 141\"]},\"columns\":[{\"id\":\"Grupo\",\"name\":\"Biome\",\"type\":\"character\",\"html\":true,\"minWidth\":240},{\"id\":\"ME\",\"name\":\"ME\",\"type\":\"character\",\"header\":\"Establishments<div class=\\\"sub\\\">median change<\\/div>\",\"html\":true,\"align\":\"right\"},{\"id\":\"MA\",\"name\":\"MA\",\"type\":\"character\",\"header\":\"Area<div class=\\\"sub\\\">median change<\\/div>\",\"html\":true,\"align\":\"right\"},{\"id\":\"MM\",\"name\":\"MM\",\"type\":\"character\",\"header\":\"Mean area<div class=\\\"sub\\\">median change<\\/div>\",\"html\":true,\"align\":\"right\"},{\"id\":\"CE\",\"name\":\"CE\",\"type\":\"character\",\"header\":\"Lost establishments<div class=\\\"sub\\\">municipalities<\\/div>\",\"html\":true,\"align\":\"right\"},{\"id\":\"CA\",\"name\":\"CA\",\"type\":\"character\",\"header\":\"Lost area<div class=\\\"sub\\\">municipalities<\\/div>\",\"html\":true,\"align\":\"right\"}],\"sortable\":false,\"pagination\":false,\"compact\":true,\"className\":\"tabela-res\",\"dataKey\":\"2d7c18fde1471f8795f90e8aa57ff1b1\"},\"children\":[]},\"class\":\"reactR_markup\"},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"reactable html-widget html-fill-item\" id=\"htmlwidget-027a7d229bb2d1c2a2dd\" style=\"width:auto;height:auto;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-027a7d229bb2d1c2a2dd\">{\"x\":{\"tag\":{\"name\":\"Reactable\",\"attribs\":{\"data\":{\"Medida\":[\"Change in the number of establishments (%)\",\"Change in area (%)\",\"Change in mean area per establishment (%)\"],\"H\":[\"5.56\",\"4.42\",\"4.12\"],\"gl\":[\"2\",\"2\",\"2\"],\"p\":[\"p = 0.062\",\"p = 0.110\",\"p = 0.128\"],\"Efeito\":[\"0.040\",\"0.032\",\"0.029\"]},\"columns\":[{\"id\":\"Medida\",\"name\":\"Measure\",\"type\":\"character\",\"minWidth\":260},{\"id\":\"H\",\"name\":\"Kruskal-Wallis H\",\"type\":\"character\",\"align\":\"right\"},{\"id\":\"gl\",\"name\":\"Degrees of freedom\",\"type\":\"character\",\"align\":\"right\"},{\"id\":\"p\",\"name\":\"p\",\"type\":\"character\",\"align\":\"right\"},{\"id\":\"Efeito\",\"name\":\"Efeito\",\"type\":\"character\",\"header\":\"Effect size<div class=\\\"sub\\\">ε² = H ÷ (n − 1)<\\/div>\",\"html\":true,\"align\":\"right\"}],\"sortable\":false,\"pagination\":false,\"compact\":true,\"dataKey\":\"85b4a31e040b51509020c78a7a93694c\"},\"children\":[]},\"class\":\"reactR_markup\"},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n\n::: {.cell-output-display}\n\n```{=html}\n<p class=\"nota-fonte\">Source: authors’ calculations based on IBGE, 2006 and 2017 Agricultural Censuses (SIDRA), all agricultural establishments; municipal database from Article C (corrected version); municipal types from RESA Project Manuscript 1 (provisional labels); dominant biome from the IBGE 1:250,000 map (2019).</p>\n```\n\n:::\n:::\n\n\nMedian municipal change, municipalities with losses and tests for differences, by dominant biome\n\n:::\n\nAs @tbl-dinamica-bioma shows, the number of establishments in the Pantanal rose by 37.8%, although the biome has only 4 municipalities. In the Amazon, the number of establishments remained almost unchanged (0.6%), while area grew by 14.4%.\n\n## Pilot-area host municipalities\n\n@tbl-sedes-dinamica shows the change in the host municipalities of the three pilot areas.\n\n::: {#tbl-sedes-dinamica}\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"aviso-municipio\">\n<b>The municipality is not the pilot area. </b>\nThe indicators describe the whole municipality (or all of its family farms), so they provide context for the pilot areas but do not measure them.\n</div>\n```\n\n:::\n\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"reactable html-widget html-fill-item\" id=\"htmlwidget-e3c407f8a61f794f1341\" style=\"width:auto;height:auto;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-e3c407f8a61f794f1341\">{\"x\":{\"tag\":{\"name\":\"Reactable\",\"attribs\":{\"data\":{\"Município\":[\"<a href=\\\"../municipios/juara.html\\\">Juara<\\/a><div class=\\\"sub\\\">Vale do Arinos<\\/div>\",\"<a href=\\\"../municipios/lucas-do-rio-verde.html\\\">Lucas do Rio Verde<\\/a><div class=\\\"sub\\\">Quatá and N. Sra. Aparecida<\\/div>\",\"<a href=\\\"../municipios/pocone.html\\\">Poconé<\\/a><div class=\\\"sub\\\">Lambari<\\/div>\"],\"Tipo\":[\"<span class=\\\"chip chip-t3\\\">T3 · High aggregate scale<\\/span>\\n<span class=\\\"rotulo-provisorio\\\" title=\\\"Label pending approval by the authors of Manuscript 1\\\">provisional label<\\/span>\",\"<span class=\\\"chip chip-t4\\\">T4 · Mechanised with tenure awaiting title<\\/span>\\n<span class=\\\"rotulo-provisorio\\\" title=\\\"Label pending approval by the authors of Manuscript 1\\\">provisional label<\\/span>\",\"<span class=\\\"chip chip-t5\\\">T5 · Horticultural-irrigated<\\/span>\\n<span class=\\\"rotulo-provisorio\\\" title=\\\"Label pending approval by the authors of Manuscript 1\\\">provisional label<\\/span>\"],\"E\":[\"1,212 → 1,689<div class=\\\"sub\\\">39.4%<\\/div>\",\"322 → 321<div class=\\\"sub\\\">−0.3%<\\/div>\",\"1,509 → 2,551<div class=\\\"sub\\\">69.1%<\\/div>\"],\"A\":[\"999,358 → 1,521,652<div class=\\\"sub\\\">52.3%<\\/div>\",\"257,413 → 315,746<div class=\\\"sub\\\">22.7%<\\/div>\",\"614,619 → 860,061<div class=\\\"sub\\\">39.9%<\\/div>\"]},\"columns\":[{\"id\":\"Município\",\"name\":\"Municipality (pilot area)\",\"type\":\"character\",\"html\":true,\"minWidth\":150},{\"id\":\"Tipo\",\"name\":\"Type\",\"type\":\"character\",\"html\":true,\"minWidth\":200},{\"id\":\"E\",\"name\":\"E\",\"type\":\"character\",\"header\":\"Establishments<div class=\\\"sub\\\">2006 → 2017 (change)<\\/div>\",\"html\":true,\"minWidth\":130,\"align\":\"right\"},{\"id\":\"A\",\"name\":\"A\",\"type\":\"character\",\"header\":\"Area, ha<div class=\\\"sub\\\">2006 → 2017 (change)<\\/div>\",\"html\":true,\"minWidth\":170,\"align\":\"right\"}],\"sortable\":false,\"pagination\":false,\"compact\":true,\"className\":\"tabela-res\",\"dataKey\":\"442b4bcc67026ef1358e9e223127dad3\"},\"children\":[]},\"class\":\"reactR_markup\"},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n\n::: {.cell-output-display}\n\n```{=html}\n<p class=\"nota-fonte\">Source: authors’ calculations based on IBGE, 2006 and 2017 Agricultural Censuses (SIDRA), all agricultural establishments; municipal database from Article C (corrected version); municipal types from RESA Project Manuscript 1 (provisional labels); dominant biome from the IBGE 1:250,000 map (2019). See also the indicators for <a href=\"../indicadores/var_estab_0617.html\">change in establishments</a> and <a href=\"../indicadores/var_area_0617.html\">change in area</a>, which include a map of the 141 municipalities.</p>\n```\n\n:::\n:::\n\n\nChange in the number and area of establishments in pilot-area host municipalities\n\n:::\n\n## Concluding remarks\n\nThis page has recalculated the dynamics of agricultural establishments between the two Censuses using the five municipal types and the dominant biome. The sums indicate an increase in the number of establishments in T5, with mean area almost unchanged. They also indicate a decrease in that number in T4 and T3, with mean area rising in T4 and area rising in T3. The statistical evidence for these differences across municipalities, however, is not clear.\n\nThese results have limitations. The figures cover all agricultural establishments, not only family farms, and the municipal sum for the first Census does not reconcile with the state table. The value of production also remains excluded from this version until the difference is explained.\n\n## Appendix: reconciliation with the state tables\n\n@tbl-conciliacao, mentioned under Data and methods, compares the municipal sum with the IBGE state tables.\n\n::: {#tbl-conciliacao}\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"reactable html-widget html-fill-item\" id=\"htmlwidget-b308d3a01a944c156b50\" style=\"width:auto;height:auto;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-b308d3a01a944c156b50\">{\"x\":{\"tag\":{\"name\":\"Reactable\",\"attribs\":{\"data\":{\"Item\":[\"Agricultural establishments, 2006\",\"Area of agricultural establishments, 2006\",\"Value of production of agricultural establishments, 2006 (at current prices)\",\"Agricultural establishments, 2017\",\"Area of agricultural establishments, 2017\"],\"Soma\":[\"112,987\",\"48,688,715\",\"R$12.29 billion\",\"118,679\",\"54,922,849\"],\"Estadual\":[\"112,978\",\"47,805,514\",\"R$9.60 billion\",\"118,679\",\"54,922,850\"],\"Confronto\":[\"112,987\",\"48,688,710\",\"—\",\"—\",\"—\"],\"Dif\":[\"9 (less than 0.01%)\",\"883,201 (1.8%)\",\"R$2.69 billion (28.0%)\",\"0\",\"−1 (less than 0.01%)\"]},\"columns\":[{\"id\":\"Item\",\"name\":\"Item\",\"type\":\"character\",\"minWidth\":230},{\"id\":\"Soma\",\"name\":\"Sum across the 141 municipalities\",\"type\":\"character\",\"align\":\"right\"},{\"id\":\"Estadual\",\"name\":\"Estadual\",\"type\":\"character\",\"header\":\"State table<div class=\\\"sub\\\">2006–2017 comparison, Total column<\\/div>\",\"html\":true,\"align\":\"right\"},{\"id\":\"Confronto\",\"name\":\"Confronto\",\"type\":\"character\",\"header\":\"IBGE comparison table<div class=\\\"sub\\\">historical Census series<\\/div>\",\"html\":true,\"align\":\"right\"},{\"id\":\"Dif\",\"name\":\"Sum − state table\",\"type\":\"character\",\"align\":\"right\"}],\"sortable\":false,\"pagination\":false,\"compact\":true,\"dataKey\":\"cf65faf7535c23ae57a8189785f00b07\"},\"children\":[]},\"class\":\"reactR_markup\"},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n\n::: {.cell-output-display}\n\n```{=html}\n<p class=\"nota-fonte\">Source: authors’ calculations based on the municipal sum from the Article C database (IBGE, 2006 and 2017 Agricultural Censuses; 2006 value of production from SIDRA table 1118), the 2006–2017 state comparison table (Total column) and the IBGE Census comparison table (historical series), from the workbook of 2017 Census state tables compiled by the project.</p>\n```\n\n:::\n:::\n\n\nReconciliation of the municipal sum with the state tables\n\n:::\n\n",
