\":[\"M6\",\"M7\",\"VM\"]}],\"sortable\":false,\"pagination\":false,\"compact\":true,\"className\":\"tabela-res\",\"language\":{\"sortLabel\":\"Ordenar por {name}\",\"filterPlaceholder\":\"Filtrar\",\"filterLabel\":\"Filtrar {name}\",\"searchPlaceholder\":\"Buscar\",\"searchLabel\":\"Buscar na tabela\",\"noData\":\"Nenhum registro encontrado\",\"pageNext\":\"Próxima\",\"pagePrevious\":\"Anterior\",\"pageNumbers\":\"{page} de {pages}\",\"pageInfo\":\"{rowStart}–{rowEnd} de {rows} linhas\",\"pageSizeOptions\":\"Mostrar {rows}\",\"pageNextLabel\":\"Próxima página\",\"pagePreviousLabel\":\"Página anterior\",\"pageNumberLabel\":\"Página {page}\",\"pageJumpLabel\":\"Ir para a página\",\"pageSizeOptionsLabel\":\"Linhas por página\",\"groupExpandLabel\":\"Expandir grupo\",\"detailsExpandLabel\":\"Mostrar detalhes\",\"selectAllRowsLabel\":\"Selecionar todas as linhas\",\"selectAllSubRowsLabel\":\"Selecionar todas as linhas do grupo\",\"selectRowLabel\":\"Selecionar linha\"},\"dataKey\":\"191b00a2ad4445a0cc905cf810fe8dfc\"},\"children\":[]},\"class\":\"reactR_markup\"},\"evals\":[],\"jsHooks\":[]}</script>\n```\n\n:::\n\n::: {.cell-output-display}\n\n```{=html}\n<p class=\"nota-fonte\">Fonte: Elaboração própria com base em IBGE, Censos Agropecuários 2006 e 2017 (SIDRA), todos os estabelecimentos agropecuários; base municipal do Artigo C (versão corrigida); tipos do Manuscrito 1 do Projeto RESA (rótulos provisórios); bioma dominante IBGE 1:250 mil (2019). Nota: variação de 2017 sobre 2006, calculada sobre as somas dos municípios de cada tipo.</p>\n```\n\n:::\n:::\n\n\nEstabelecimentos, área e área média, por tipo municipal (rótulos provisórios)\n\n:::\n\n::: {#fig-dinamica fig-cap-location=\"top\"}\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n```{=html}\n<figure class=\"grafico-svg\"><svg viewBox=\"0 0 680 268\" width=\"100%\" role=\"img\" aria-label=\"Variação 2006–2017 por tipo e por bioma\"><text x=\"92\" y=\"41.0\" font-size=\"11.5\" text-anchor=\"end\" fill=\"#1f2937\"